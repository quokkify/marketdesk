FROM nginx:1.27-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
COPY docker/nginx/assets.conf /etc/nginx/conf.d/default.conf
COPY public/marketdesk-mark.svg /usr/share/nginx/html/marketdesk-mark.svg
COPY public/favicon-32x32.png /usr/share/nginx/html/favicon-32x32.png
COPY public/apple-touch-icon.png /usr/share/nginx/html/apple-touch-icon.png
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/marketdesk-mark.svg || exit 1
