FROM caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b
COPY docker/caddy/assets.Caddyfile /etc/caddy/Caddyfile
COPY public/marketdesk-mark.svg /srv/marketdesk-mark.svg
COPY public/favicon-32x32.png /srv/favicon-32x32.png
COPY public/apple-touch-icon.png /srv/apple-touch-icon.png
COPY public/assets-manifest.json /srv/assets-manifest.json
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 CMD wget --quiet --tries=1 --spider http://127.0.0.1:8080/marketdesk-mark.svg || exit 1
