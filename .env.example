# Create .env with `npm run env:init`: it copies this file and generates JWT_SECRET,
# JWT_REFRESH_SECRET, HERMES_WEBHOOK_SECRET and MARKETPLACE_CREDENTIALS_KEY when they are empty or
# a your_* placeholder. The app refuses to start without a valid JWT_SECRET and
# MARKETPLACE_CREDENTIALS_KEY; the other two are not needed to boot. Values that are already set
# are never overwritten.

# Application
# Release metadata is intentionally absent here. Use `npm run compose:release -- up -d`.
NODE_ENV=development
APP_NAME=hermes-marketdesk
APP_PORT=3000
LOG_LEVEL=debug
# The run recorder is on in development, writes to .local/runs/ and is always off in production.
# RUN_RECORDER=off
# Directory the recorder writes to; a relative path is relative to where the app is started.
# RUN_RECORDER_DIR=./.local/runs
TRUST_PROXY=false
# Self-service sign-up on the login page. Empty or true keeps it open; false makes
# POST /api/auth/register answer 403. Set false on a private production instance once its
# accounts exist.
REGISTRATION_ENABLED=
# Requests per minute per workspace, shared by every route that calls the AI provider
# (AI draft, recheck, improvements, Hermes run). Empty means 10.
AI_RATE_LIMIT_PER_MINUTE=
# Public base URL of this backend, for example https://marketdesk.example.com. Product photos
# are stored as /uploads/... paths; the OLX adapter sends them to OLX as absolute URLs on this
# base, because OLX downloads advert photos itself. With OLX_ADAPTER_MODE=real it must be an
# address reachable from the internet: the app refuses to start while it is empty, loopback or
# private. In the sandbox it may stay empty: the origin of OLX_REDIRECT_URI is used, or
# http://localhost:3000 without one.
PUBLIC_BASE_URL=

# Database
# Optional. Leave empty to use the DB_* fields below (native development uses
# localhost; Docker Compose overrides the internal host to its `postgres` service).
# Set a full URL only for an external/managed PostgreSQL endpoint.
DATABASE_URL=
# Use disable for local/internal Docker Compose PostgreSQL. Use verify-full for an
# external TLS PostgreSQL endpoint; certificate verification cannot be disabled.
DB_SSL_MODE=disable
DB_HOST=localhost
DB_PORT=5432
DB_USER=marketdesk
DB_PASSWORD=marketdesk
DB_NAME=marketdesk
DB_POOL_MIN=2
DB_POOL_MAX=10

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD: leave EMPTY for no authentication (the default for local dev and
# docker-compose). When set to a non-empty value, docker-compose starts redis with
# --requirepass and the app authenticates with the same value. Do NOT wrap in quotes.
REDIS_PASSWORD=

# JWT
# `npm run env:init` replaces an empty or your_* value with a random secret. The app refuses to
# start with a placeholder or a JWT_SECRET shorter than 32 characters. For `npm run dev` only,
# uncomment the next line to tolerate a placeholder; it is ignored in production.
# ALLOW_INSECURE_DEV_JWT=true
JWT_SECRET=your_jwt_secret_key_change_in_production
# How long a sign-in lasts without activity, as <integer><s|m|h|d>. Longer than 24h boots with a
# warning. A session that stays active gets a fresh token once its token is older than
# JWT_RENEW_AFTER, which must be shorter than JWT_EXPIRATION.
JWT_EXPIRATION=24h
JWT_RENEW_AFTER=12h
# Refresh tokens are not implemented: JWT_REFRESH_SECRET is generated but unused, and JWT_REFRESH_EXPIRATION has no effect.
JWT_REFRESH_SECRET=your_jwt_refresh_secret_key_change_in_production
JWT_REFRESH_EXPIRATION=7d

# Hermes Agent API Server (same VPS, app in Docker -> host gateway)
# MarketDesk uses Hermes only when its API server reports no enabled toolsets (GET /v1/toolsets);
# otherwise it is treated as unavailable. Use a dedicated Hermes profile without tools, served at
# http://host.docker.internal:8642/p/<profile>/v1, and set HERMES_API_URL to that URL.
# HERMES_API_KEY must match that profile's own API_SERVER_KEY in ~/.hermes/profiles/<profile>/.env.
HERMES_API_KEY=your_local_hermes_api_server_key
HERMES_API_URL=http://host.docker.internal:8642/v1
HERMES_MODEL=hermes-agent
HERMES_REQUEST_TIMEOUT_MS=30000
# Filled by `npm run env:init`.
HERMES_WEBHOOK_SECRET=your_hermes_webhook_secret
# AI provider routing: auto uses Hermes while it is configured, reachable and reports no
# enabled toolsets, and the built-in offline heuristics otherwise; hermes never falls back; offline never calls
# Hermes. A your_-prefixed HERMES_API_KEY counts as not configured.
HERMES_PROVIDER_MODE=auto
# subscription_included when the Hermes provider is a flat subscription (no per-call invoice): AI usage then
# reads "included in subscription". Empty means the cost of a Hermes call is unknown.
HERMES_BILLING_MODE=
# File the host timer writes with `hermes -p <profile> usage --json`; the app shows the AI provider's account
# limits from it. Empty means limits are not configured. The Compose app mounts ./hermes-usage there (read-only).
HERMES_USAGE_FILE=/app/hermes-usage/usage.json
# Market search ("Find comparables on OLX"): a separate Hermes profile whose API server enables exactly the
# web toolset, at http://host.docker.internal:8642/p/<research-profile>/v1 with that profile's own
# API_SERVER_KEY. Empty URL or key (or a your_-prefixed key) leaves the search off. Uses HERMES_MODEL and
# HERMES_BILLING_MODE; the timeout per call defaults to 180000 ms because the agent searches and opens pages.
# HERMES_RESEARCH_MAX_CONCURRENCY caps research calls running at once in the app process (default 3).
HERMES_RESEARCH_API_URL=
HERMES_RESEARCH_API_KEY=
HERMES_RESEARCH_TIMEOUT_MS=
HERMES_RESEARCH_MAX_CONCURRENCY=

# Buyer reply drafts. Empty means the default in brackets.
# Reply runs (one per new buyer message) per workspace per UTC day [200].
REPLY_DAILY_RUN_CAP=
# Newest thread messages the AI sees when it drafts a reply [12].
REPLY_HISTORY_MESSAGES=
# A buyer message older than this many days gets no automatic draft; the seller can still regenerate [14].
REPLY_MAX_MESSAGE_AGE_DAYS=
# The same buyer text in this many workspace messages within 7 days marks the thread suspicious [3].
REPLY_SPAM_REPEAT_THRESHOLD=
# This many buyer messages in one thread within an hour mark the thread suspicious [10].
REPLY_FLOOD_PER_HOUR=

# External Marketplace APIs
# OLX PL real API readiness. Keep OLX_ADAPTER_MODE=stub until official OAuth
# credentials are approved and stored securely outside git. Keep live publish disabled
# until a human explicitly approves the first real listing.
# Set OLX_ADAPTER_MODE explicitly before a real deploy. stub, the default, is the labelled
# sandbox: every OLX surface is labelled Sandbox, category search uses the built-in stub
# taxonomy, and connecting OLX again in stub mode, for example after a disconnect, overwrites
# stored real OLX tokens with sandbox ones. real calls the OLX Partner API. Any other value
# stops the app at startup.
OLX_MARKET=PL
OLX_ADAPTER_MODE=stub
OLX_API_BASE_URL=https://www.olx.pl/api/partner
# Public OLX site whose search pages the listing response check reads. Empty means https://www.olx.pl.
OLX_SEARCH_BASE_URL=
OLX_AUTH_URL=https://www.olx.pl/oauth/authorize
OLX_TOKEN_URL=https://www.olx.pl/api/open/oauth/token
OLX_CLIENT_ID=
OLX_CLIENT_SECRET=
OLX_REQUIRED_SCOPES=read write v2
OLX_REDIRECT_URI=http://localhost:3000/api/marketplaces/olx/oauth/callback
OLX_OAUTH_SUCCESS_URL=http://localhost:3000/marketplaces
OLX_LIVE_PUBLISH_ENABLED=false
OLX_PRICE_NEGOTIABLE=false
OLX_DELIVERY_ATTRIBUTE_CODE=
OLX_DELIVERY_OPTION_CODE=
# Base64 32-byte key that encrypts stored marketplace credentials. Required: the app refuses to
# start without it. `npm run env:init` generates one, or use `openssl rand -base64 32`.
# Replacing it later makes already stored marketplace credentials unreadable.
MARKETPLACE_CREDENTIALS_KEY=
OLX_REQUEST_TIMEOUT_MS=30000
OLX_CATEGORY_IDS_JSON={}
OLX_DEFAULT_CATEGORY_ID=
OLX_CITY_ID=
OLX_DISTRICT_ID=
OLX_CONTACT_NAME=
OLX_CONTACT_PHONE=
OLX_ADVERTISER_TYPE=private
OLX_CONDITION_ATTRIBUTE_CODE=

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=52428800
UPLOAD_DIR=./uploads
